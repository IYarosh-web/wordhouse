{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "app/*": ["app/*"],
      "pages/*": ["pages/*"],
      "widgets/*": ["widgets/*"],
      "features/*": ["features/*"],
      "entities/*": ["entities/*"],
      "shared/*": ["shared/*"],
      "shared/ui": ["shared/ui/index"]
    },
    "jsx": "react-jsx",
    "module": "ES2022",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"]
}
